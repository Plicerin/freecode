{
  "name": "freecode",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "freecode": "dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "build": "bun build src/cli.tsx --target=bun --outdir=dist",
    "build:exe": "bun build --compile src/cli.tsx --outfile=dist/freecode.exe",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "serve": "bun run src/commands/serve.ts"
  },
  "dependencies": {
    "ink": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.0.0",
    "ink-text-input": "^6.0.0",
    "ink-autocomplete": "^1.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "zod": "^3.23.0",
    "fast-glob": "^3.3.2",
    "chokidar": "^4.0.1",
    "jsonc-parser": "^3.3.1",
    "diff": "^7.0.0",
    "turndown": "^7.2.0",
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/diff": "^6.0.0",
    "@types/react": "^19.0.0",
    "@types/turndown": "^5.0.5",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
