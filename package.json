{
  "name": "@vrocket/freecode",
  "version": "0.1.7",
  "description": "A universal AI execution layer built for correctness. Runs any model from any provider and validates its own outputs by default — a consistent, trustworthy interface for AI development, without vendor lock-in or manual verification overhead.",
  "type": "module",
  "license": "MIT",
  "author": "Plicerin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plicerin/freecode.git"
  },
  "homepage": "https://github.com/Plicerin/freecode#readme",
  "bugs": {
    "url": "https://github.com/Plicerin/freecode/issues"
  },
  "keywords": [
    "ai",
    "cli",
    "coding-agent",
    "llm",
    "agent",
    "openai",
    "anthropic",
    "local-models"
  ],
  "bin": {
    "freecode": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "build:exe": "bun run scripts/build-exe.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "serve": "bun run src/commands/serve.ts"
  },
  "dependencies": {
    "ink": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.0.0",
    "ink-text-input": "^6.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "zod": "^3.23.0",
    "fast-glob": "^3.3.2",
    "chokidar": "^4.0.1",
    "jsonc-parser": "^3.3.1",
    "diff": "^7.0.0",
    "turndown": "^7.2.0",
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/diff": "^6.0.0",
    "@types/react": "^19.0.0",
    "@types/turndown": "^5.0.5",
    "esbuild": "^0.28.1",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/cli.js",
    "dist/main.js"
  ]
}
